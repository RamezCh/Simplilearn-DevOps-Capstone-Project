pipeline {
  agent any
  tools{
  maven 'mymaven'
  }
  stages{
    stage('Checkout Code'){
      steps{git 'https://github.com/Sonal0409/MavenBuild-SL.git'}
    }
    stage('Build the Code'){
      steps{
      sh 'mvn package'
      }
    }
    stage('Build the Image'){
      steps{
      sh 'docker build -t capstoneproject:$BUILD_NUMBER .'
      }
    }
  }
}
